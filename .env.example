# MemShift Browser Extension Environment Configuration
# ========================================================
# SECURITY NOTICE:
# The browser extension is an untrusted public client.
# NEVER place SUPABASE_SERVICE_ROLE_KEY, AI provider keys (OpenAI, Gemini, Anthropic),
# or database passwords in this file or any extension build environment.

# Public Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (Safe for public clients, protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# MemShift API / Edge Functions Base URL
VITE_MEMSHIFT_API_URL=https://your-project.supabase.co/functions/v1
